# 1. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model to use. Run `python agent.py models` to see what your key can use.
CONVOY_MODEL=gemini-3.5-flash

# What goes in your Digest tab (separate topics with ;)
DIGEST_TOPICS=Indian stock market (Nifty, Sensex); upcoming and recent IPOs in India; gold price in India today (24K and 22K per 10g); major science news

# Show/hide the sidebar
HOTKEY=ctrl+alt+space

# Apps the activity tracker never records (exe names, comma-separated)
EXCLUDE_APPS=keepass.exe,1password.exe,bitwarden.exe,lockapp.exe

# Obsidian vault (the folder that contains .obsidian). Leave empty to turn the export off.
OBSIDIAN_VAULT=

# Anthropic key from https://console.anthropic.com/settings/keys (paste after the =)
ANTHROPIC_API_KEY=

# Claude model for chat, brief and meeting prep (needs ANTHROPIC_API_KEY with credit; falls back to Gemini otherwise)
CLAUDE_MODEL=claude-opus-5-5

# Journal sync script run before each morning brief (empty = off). Only lines starting TODO: or - [ ] are used.
JOURNAL_SYNC=

# Optional second inbox, read-only over IMAP (e.g. GoDaddy Professional Email: imap.secureserver.net; plain Titan: imap.titan.email)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
